# Store the populated dotenv as GitHub production secret PROD_ENV_FILE.
# Actions installs a versioned 0600 copy automatically. Never commit real values.
APP_URL=https://app.example.com
NEXT_PUBLIC_BUILDER_URL=https://app.example.com
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
REALTIME_BROADCAST_SECRET=
JAVASCRIPT_EXECUTOR_TOKEN=
NEXT_PUBLIC_EDITION=community
FORCE_PUBLIC_HTTPS=true
POSTGRES_DB=chatbotx
POSTGRES_USER=chatbotx
POSTGRES_PASSWORD=
# Percent-encode reserved characters in the password for this URI.
DATABASE_URL=postgresql://chatbotx:REPLACE@postgres:5432/chatbotx
# Preserve the existing volume names if adopting an existing installation.
POSTGRES_VOLUME_NAME=chatworkai-postgres-data
REDIS_VOLUME_NAME=chatworkai-redis-data
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=chatworkai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Worker public-reader, NOT a public bucket/custom-domain binding to the bucket.
NEXT_PUBLIC_STORAGE_URL=https://media.example.com/
NEXT_PUBLIC_INTERNAL_STORAGE_URL=https://media.example.com/
REDIS_URL=redis://redis:6379
ZALO_ACCOUNT_GATEWAY_ENABLED=false
# Keep existing worker/transport flags and provider credentials from your .env.
# For migration-changing releases only: paste the reviewed migration digest.
APPROVED_MIGRATION_DIGEST=

# Explicit one-time seed approval for a NEW empty installation only.
# Existing installations should keep false; upgrades never reseed automatically.
INITIAL_SEED_APPROVED=false
